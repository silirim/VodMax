# VodMax server as a systemd service. Install:
#   useradd --system --home /var/lib/vodmax --shell /usr/sbin/nologin vodmax
#   install -m 755 vodmax-server vodmax-update /usr/local/bin/
#   install -d -o vodmax -g vodmax -m 700 /var/lib/vodmax
#   cp vodmax.service /etc/systemd/system/ && systemctl enable --now vodmax
#   usermod -aG render vodmax   (only with a graphics card in /dev/dri)
# The admin token is in /var/lib/vodmax/admin.token. ffmpeg (and ffprobe)
# from the distribution are needed for MKV/AVI in the browser, pause of
# live TV and recordings.
[Unit]
Description=VodMax server
After=network-online.target
Wants=network-online.target

[Service]
User=vodmax
Group=vodmax
ExecStart=/usr/local/bin/vodmax-server -data /var/lib/vodmax -listen 0.0.0.0:8095
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vodmax
# ffmpeg reads the provider's streams and the assistant runs a downloaded
# engine: if one of them is exploited, it gets no kernel knobs, raw or
# packet sockets, namespaces or unusual system calls. Left out on purpose:
# PrivateDevices and ProtectClock (both close /dev/dri, the graphics card),
# MemoryDenyWriteExecute (Vulkan and llama.cpp generate code) and
# SystemCallArchitectures (an armv7 build on a 64-bit kernel). The VPN runs
# in user space: no TUN device, no namespaces.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
# A refused call fails with an error instead of killing the service.
SystemCallErrorNumber=EPERM
# Local collections are read where the service can see them (/mnt, /srv,
# /media...); with ProtectHome=yes folders under /home are hidden.

[Install]
WantedBy=multi-user.target
