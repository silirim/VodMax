# VodMax server as a systemd service. Install:
#   useradd --system --home /var/lib/vodmax --shell /usr/sbin/nologin vodmax
#   install -m 755 vodmax-server vodmax-update /usr/local/bin/
#   install -d -o vodmax -g vodmax -m 700 /var/lib/vodmax
#   cp vodmax.service /etc/systemd/system/ && systemctl enable --now vodmax
#   usermod -aG render vodmax   (only with a graphics card in /dev/dri)
# The admin token is in /var/lib/vodmax/admin.token. ffmpeg (and ffprobe)
# from the distribution are needed for MKV/AVI in the browser, pause of
# live TV and recordings.
[Unit]
Description=VodMax server
After=network-online.target
Wants=network-online.target

[Service]
User=vodmax
Group=vodmax
ExecStart=/usr/local/bin/vodmax-server -data /var/lib/vodmax -listen 0.0.0.0:8095
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vodmax
# Local collections are read where the service can see them (/mnt, /srv,
# /media...); with ProtectHome=yes folders under /home are hidden.

[Install]
WantedBy=multi-user.target
