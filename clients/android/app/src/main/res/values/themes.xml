<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VodMax" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/soft</item>
        <item name="android:buttonStyle">@style/VodMax.Button</item>
        <item name="android:editTextStyle">@style/VodMax.Field</item>
    </style>
    <!-- The setup screen's buttons, as the web's: a raised pill with a
         hairline, white with dark text when focused (the remote) or pressed. -->
    <style name="VodMax.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/vm_button</item>
        <item name="android:textColor">@color/vm_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <!-- Text fields: a raised rounded box, white border when focused. -->
    <style name="VodMax.Field" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/vm_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="VodMax.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
